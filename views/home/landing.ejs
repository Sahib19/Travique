<% layout("/layouts/boilerplate") %>

<section class="landing-hero">
    <div class="landing-hero__content">
        <p class="landing-eyebrow">Travel · Stories · Community</p>
        <h1>Design your next escape with destinations handpicked for dreamers.</h1>
        <p class="landing-hero__subtitle">
            Travique blends soulful stays, curated experiences, and a vibrant host community so every journey
            feels personal, safe, and unforgettable.
        </p>

        <div class="landing-hero__cta">
            <a href="/listing" class="btn btn-gradient">
                <i class="fa-solid fa-compass"></i> Explore stays
            </a>
            <a href="/listing/new" class="btn btn-glass">
                <i class="fa-solid fa-plus"></i> Become a host
            </a>
        </div>

        <div class="landing-metrics">
            <div>
                <span>2,300+</span>
                Curated destinations
            </div>
            <div>
                <span>140+</span>
                Cities & landscapes
            </div>
            <div>
                <span>98%</span>
                Happy travelers
            </div>
        </div>
    </div>

    <div class="landing-hero__visual">
        <div class="hero-passport">
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=900&q=80"
                alt="Ocean" />
            <div class="hero-passport__card">
                <p>Sunrise Lagoon · Bali</p>
                <span>₹ 8,400 / night</span>
                <div class="badge text-bg-light text-dark">Trending now</div>
            </div>
        </div>
        <div class="hero-flight-card">
            <p>Instant itineraries</p>
            <h3>Build a wishlist, share with friends & book together.</h3>
            <div class="hero-flight__avatars">
                <span class="avatar is-primary">A</span>
                <span class="avatar is-secondary">K</span>
                <span class="avatar is-tertiary"><i class="fa-solid fa-plus"></i></span>
            </div>
        </div>
    </div>
</section>

<section class="landing-pillars">
    <div class="pillar-card">
        <div class="pillar-icon">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
        </div>
        <h3>Curated for mood</h3>
        <p>Pick from design-led lofts, hidden cabins, rainforest domes, or seaside villas tailored to your vibe.</p>
    </div>
    <div class="pillar-card">
        <div class="pillar-icon">
            <i class="fa-solid fa-shield-heart"></i>
        </div>
        <h3>Verified hosts</h3>
        <p>Every host passes identity, quality, and hospitality checks so you can book with total confidence.</p>
    </div>
    <div class="pillar-card">
        <div class="pillar-icon">
            <i class="fa-solid fa-comments"></i>
        </div>
        <h3>Real-time concierge</h3>
        <p>Chat instantly, manage bookings, and get on-trip assistance inside Travique’s secure inbox.</p>
    </div>
</section>

<section class="landing-collections">
    <div class="collections-header">
        <div>
            <p class="landing-eyebrow">Collections</p>
            <h2>Find scenes you’ll brag about</h2>
        </div>
        <a href="/listing" class="link-pill">
            Browse all <i class="fa-solid fa-arrow-right-long"></i>
        </a>
    </div>

    <div class="collection-grid">
        <a class="collection-card gradient-one" href="/listing?category=Mountains">
            <div>
                <h3>Misty Mountains</h3>
                <p>Treks, cabins & alpine air</p>
            </div>
            <span>View getaways</span>
        </a>
        <a class="collection-card gradient-two" href="/listing?category=Beaches">
            <div>
                <h3>Azure Shores</h3>
                <p>Private sands & secret lagoons</p>
            </div>
            <span>View retreats</span>
        </a>
        <a class="collection-card gradient-three" href="/listing?category=Heritage%20Sites">
            <div>
                <h3>Living Heritage</h3>
                <p>Palaces, forts & timeless art</p>
            </div>
            <span>View residencies</span>
        </a>
        <a class="collection-card gradient-four" href="/listing?category=Rooms">
            <div>
                <h3>Designer Rooms</h3>
                <p>Stylish stays under ₹5k</p>
            </div>
            <span>View stays</span>
        </a>
    </div>
</section>

<section class="landing-experiences">
    <div class="section-header">
        <p class="landing-eyebrow">How Travique helps</p>
        <div>
            <h2>Plan, host, and dream in one place</h2>
            <p class="section-subtitle">Tools for travelers and hosts to stay organized, inspired, and ready for every adventure.</p>
        </div>
    </div>
    <div class="experience-card">
        <h3>Plan with purpose</h3>
        <p>Layer filters for budget, tribe size, and interests. Save to collections and share private itineraries with friends.</p>
        <ul>
            <li><i class="fa-solid fa-check"></i> Smart filters & price watch</li>
            <li><i class="fa-solid fa-check"></i> Collaborative wishlists</li>
            <li><i class="fa-solid fa-check"></i> Transparent host reviews</li>
        </ul>
    </div>
    <div class="experience-card highlight">
        <h3>Host with flair</h3>
        <p>From onboarding to guest chats, Travique equips hosts with analytics, review insights, and payout tracking.</p>
        <div class="host-stats">
            <div>
                <span>4.9/5</span>
                Avg. host rating
            </div>
            <div>
                <span>72 hrs</span>
                Listing approval
            </div>
        </div>
        <a href="/listing/new" class="btn btn-light w-100">Launch my stay</a>
    </div>
    <div class="experience-card">
        <h3>Stay inspired</h3>
        <p>Weekly drops highlight limited-time adventures — from arctic domes to desert observatories.</p>
        <div class="drop-card">
            <p>Next drop</p>
            <h4>“Aurora Nights” · Scandinavia</h4>
            <span>Opens Friday · 25 spots</span>
        </div>
    </div>
</section>

<section class="landing-cta">
    <div>
        <p class="landing-eyebrow">Ready when you are</p>
        <h2>There’s a Travique story waiting for you.</h2>
        <p>Join thousands exploring soulful stays across continents.</p>
    </div>
    <div class="cta-actions">
        <a href="/listing" class="btn btn-gradient">Start exploring</a>
        <a href="/user/signup" class="btn btn-glass">Create account</a>
    </div>
</section>
